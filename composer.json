{
    "name": "tinymvc/fireline-php",
    "description": "Fireline PHP (tinymvc/spark) adapter for Fireline Js",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Spark\\Fire\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "require": {
        "php": "^8.2",
        "tinymvc/tinycore": "^4.0.7"
    },
    "scripts": {
        "test": "@php tests/run.php"
    }
}
